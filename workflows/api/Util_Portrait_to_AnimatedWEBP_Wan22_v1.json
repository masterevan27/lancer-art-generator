{
  "1": {
    "class_type": "LoadImage",
    "_meta": {"title": "Portrait source (patched by animate-portrait.py)"},
    "inputs": {"image": "portrait.png [input]"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "umt5 - Wan text encoder"},
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Motion description (patched)"},
    "inputs": {"clip": ["2", 0], "text": "the character breathes gently"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative (patched)"},
    "inputs": {"clip": ["2", 0], "text": "static, still image"}
  },
  "5": {
    "class_type": "VAELoader",
    "_meta": {"title": "Wan 2.1 VAE - the A14B I2V pair's VAE, not wan2.2_vae"},
    "inputs": {"vae_name": "wan_2.1_vae.safetensors"}
  },
  "6": {
    "class_type": "WanImageToVideo",
    "_meta": {"title": "Portrait -> video latent (size/length patched)"},
    "inputs": {
      "positive": ["3", 0],
      "negative": ["4", 0],
      "vae": ["5", 0],
      "start_image": ["1", 0],
      "width": 480,
      "height": 480,
      "length": 33,
      "batch_size": 1
    }
  },
  "7": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Wan 2.2 I2V high noise"},
    "inputs": {
      "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "8": {
    "class_type": "ModelSamplingSD3",
    "_meta": {"title": "shift 8.0 - high noise"},
    "inputs": {"model": ["7", 0], "shift": 8.0}
  },
  "9": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Wan 2.2 I2V low noise"},
    "inputs": {
      "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "10": {
    "class_type": "ModelSamplingSD3",
    "_meta": {"title": "shift 8.0 - low noise"},
    "inputs": {"model": ["9", 0], "shift": 8.0}
  },
  "11": {
    "class_type": "KSamplerAdvanced",
    "_meta": {"title": "Pass 1 - high noise, steps 0-10, keeps leftover noise"},
    "inputs": {
      "model": ["8", 0],
      "positive": ["6", 0],
      "negative": ["6", 1],
      "latent_image": ["6", 2],
      "add_noise": "enable",
      "noise_seed": 0,
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 0,
      "end_at_step": 10,
      "return_with_leftover_noise": "enable"
    }
  },
  "12": {
    "class_type": "KSamplerAdvanced",
    "_meta": {"title": "Pass 2 - low noise, steps 10-end, adds no fresh noise"},
    "inputs": {
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["6", 1],
      "latent_image": ["11", 0],
      "add_noise": "disable",
      "noise_seed": 0,
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 10,
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable"
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["12", 0], "vae": ["5", 0]}
  },
  "14": {
    "class_type": "ReverseImageBatch",
    "_meta": {"title": "Ping-pong: the way back"},
    "inputs": {"images": ["13", 0]}
  },
  "15": {
    "class_type": "GetImageRangeFromBatch",
    "_meta": {"title": "Drop the two frames the seam would duplicate (patched)"},
    "inputs": {"images": ["14", 0], "start_index": 1, "num_frames": 31}
  },
  "16": {
    "class_type": "ImageBatch",
    "_meta": {"title": "forward + reversed = a loop that lands on frame 0"},
    "inputs": {"image1": ["13", 0], "image2": ["15", 0]}
  },
  "17": {
    "class_type": "SaveAnimatedWEBP",
    "_meta": {"title": "Animated portrait (fps/prefix patched)"},
    "inputs": {
      "images": ["16", 0],
      "filename_prefix": "AnimatedPortraits/portrait",
      "fps": 16.0,
      "lossless": false,
      "quality": 90,
      "method": "default"
    }
  }
}
