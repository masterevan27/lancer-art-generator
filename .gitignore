# Python bytecode
__pycache__/
*.pyc

# ComfyUI run logs (local state, regenerated per machine)
.generated-manifest.json
.generated-npcs.json
# The import GUI's per-library record of which NPCs the user has already
# looked at; it sits beside the manifest it describes, so it lands here.
.npc-seen.json

# Local ComfyUI output, when COMFYUI_OUTPUT_DIR is unset
output/

# Staged trait candidates are a working folder; examples/ ships tracked.
prompts/staged-imports/*.json
# The reference images npc-trait-import copies beside each run, so the import
# GUI can show what a candidate was read from. Local working state like the
# JSON above, and heavy with it - a large run is 50-100MB of somebody else's
# asset library.
prompts/staged-imports/refs/

# Spaceship candidates use the GUI's separate staging directory.
prompts/staged-imports-spaceship/*.json
prompts/staged-imports-spaceship/refs/

# Agent scratch: worktrees and subagent-driven-development ledgers
.claude/worktrees/
.superpowers/

# Ignore the batch work directory, which is a local working folder for the spaceship-trait-import skill:
prompts/ship-batch5-work

